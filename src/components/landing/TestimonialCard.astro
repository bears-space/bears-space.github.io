---
// Testimonial Card Component
import Img from "@mdx/Img.astro";
import type { ImageMetadata } from "astro";

interface Props {
  quote: string;
  name: string;
  role: string;
  image: ImageMetadata;
  profileHref: string;
}

const { quote, name, role, image, profileHref } = Astro.props;
---

<div
  class="w-full bg-bears-bg-light rounded-2xl border border-white/10 shadow-[0_4px_12px_rgba(0,0,0,0.4)] py-10 sm:py-10 lg:py-12 px-6 sm:px-8 lg:px-10"
>
  <div
    class="flex flex-row gap-4 sm:gap-6 lg:gap-16 xl:gap-20 items-center"
  >
    <!-- Left: Image (1/3 width on desktop) -->
    <a
      href={profileHref}
      class="testimonial-image-wrapper shrink-0 w-28 sm:w-40 lg:w-1/3 aspect-square overflow-hidden rounded-xl shadow-[0_8px_24px_rgba(0,0,0,0.5)] bg-white transition-transform duration-300 hover:scale-[1.02] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bears-accent"
      aria-label={`View ${name} in Faces of BEARS`}
    >
      <Img
        src={image}
        alt={name}
        fill={true}
        loading="lazy"
        sizes="(min-width: 1024px) 16vw, (min-width: 640px) 160px, 112px"
        enableClickToEnlarge={false}
      />
    </a>

<style>
  .testimonial-image-wrapper :global(img) {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
  }
</style>

    <!-- Right: Content (2/3 width on desktop) -->
    <div
      class="flex-1 lg:w-2/3 flex flex-col justify-center text-left pr-0 lg:pr-8 min-w-0"
    >
      <!-- Name -->
      <a href={profileHref} class="group w-fit">
        <h3
          class="text-lg sm:text-2xl lg:text-3xl font-extrabold text-bears-text-onLight mb-1 sm:mb-2 group-hover:text-bears-accent group-focus-visible:text-bears-accent"
        >
          {name}
        </h3>
      </a>

      <!-- Role -->
      <p
        class="text-xs sm:text-base lg:text-lg text-bears-accent-muted mb-2 sm:mb-4 lg:mb-6"
      >
        {role}
      </p>

      <!-- Quote -->
      <p
        class="text-sm sm:text-lg lg:text-xl text-bears-text-onLight leading-relaxed italic"
      >
        "{quote}"
      </p>
    </div>
  </div>
</div>
